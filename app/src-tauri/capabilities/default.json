{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口默认能力：核心 + 保存对话框 + 文本文件读写 + 自动更新 + 更新后重启",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "updater:default",
    "process:allow-restart",
    {
      "identifier": "fs:allow-write-text-file",
      "scope": {
        "allow": [{ "path": "**" }]
      }
    },
    {
      "identifier": "fs:allow-read-text-file",
      "scope": {
        "allow": [{ "path": "**" }]
      }
    }
  ]
}
